<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SlimMind 바디코드 진단 리포트</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ══════════════════════════════════════════════
   RESET & FONT
══════════════════════════════════════════════ */
*{box-sizing:border-box;margin:0;padding:0}
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap');
:root{
  --font:'Noto Sans KR','Apple SD Gothic Neo','Malgun Gothic',sans-serif;
  --sm-teal:#3ECBA5; --navy:#0B2545;
  /* BC 기본값 (JS가 덮어씀) */
  --bc-accent:#3ECBA5; --bc-main:#0B2545;
  --bc-bg:#E8FAF5; --bc-mid:#C5F0E4;
  --bc-cover-grad:linear-gradient(135deg,#060D1A 0%,#0B2545 60%,#060D1A 100%);
}
/* BC 컬러 테마 */
.bc-theme-BC-01{--bc-main:#1A3A8F;--bc-bg:#EEF2FF;--bc-accent:#F59E0B;--bc-mid:#C7D2FE;--bc-cover-grad:linear-gradient(135deg,#060D1A 0%,#1A3A8F 55%,#0B2545 100%)}
.bc-theme-BC-02{--bc-main:#7C2D12;--bc-bg:#FFF7ED;--bc-accent:#FB923C;--bc-mid:#FED7AA;--bc-cover-grad:linear-gradient(135deg,#0B1A0A 0%,#7C2D12 55%,#0B2545 100%)}
.bc-theme-BC-03{--bc-main:#1E3A5F;--bc-bg:#F0F7FF;--bc-accent:#38BDF8;--bc-mid:#BAE6FD;--bc-cover-grad:linear-gradient(135deg,#060D1A 0%,#1E3A5F 55%,#164E63 100%)}
.bc-theme-BC-04{--bc-main:#3D1F00;--bc-bg:#FDF6EE;--bc-accent:#D97706;--bc-mid:#FDE68A;--bc-cover-grad:linear-gradient(135deg,#1A0A00 0%,#3D1F00 55%,#0B2545 100%)}
.bc-theme-BC-05{--bc-main:#4A1040;--bc-bg:#FDF4FF;--bc-accent:#C084FC;--bc-mid:#E9D5FF;--bc-cover-grad:linear-gradient(135deg,#1A0020 0%,#4A1040 55%,#2D0A3D 100%)}
.bc-theme-BC-06{--bc-main:#0C3547;--bc-bg:#F0FBFF;--bc-accent:#67E8F9;--bc-mid:#A5F3FC;--bc-cover-grad:linear-gradient(135deg,#020E14 0%,#0C3547 55%,#083344 100%)}
.bc-theme-BC-07{--bc-main:#064E3B;--bc-bg:#F0FDF4;--bc-accent:#34D399;--bc-mid:#A7F3D0;--bc-cover-grad:linear-gradient(135deg,#022c22 0%,#064E3B 55%,#065F46 100%)}
.bc-theme-BC-08{--bc-main:#374151;--bc-bg:#F3F4F6;--bc-accent:#A78BFA;--bc-mid:#DDD6FE;--bc-cover-grad:linear-gradient(135deg,#111827 0%,#374151 55%,#1F2937 100%)}
.bc-theme-BC-09{--bc-main:#3B0764;--bc-bg:#FAF5FF;--bc-accent:#E879F9;--bc-mid:#F0ABFC;--bc-cover-grad:linear-gradient(135deg,#0B0020 0%,#3B0764 55%,#1A0030 100%)}
.bc-theme-BC-10{--bc-main:#7C0010;--bc-bg:#FFF1F2;--bc-accent:#FB7185;--bc-mid:#FECDD3;--bc-cover-grad:linear-gradient(135deg,#1C0A00 0%,#7C0010 55%,#450010 100%)}

html{scroll-behavior:smooth}
body{font-family:var(--font);background:#D4DCE8;min-height:100vh;color:#1C2833}

/* ══════════════════════════════════════════════
   A4 WRAP
══════════════════════════════════════════════ */
.a4-wrap{max-width:800px;margin:0 auto;padding:16px 12px 48px}

/* ══════════════════════════════════════════════
   CHAPTER 기본
══════════════════════════════════════════════ */
.chapter{
  background:#fff;width:100%;min-height:1123px;
  margin-bottom:0;display:none;flex-direction:column;position:relative;
  box-shadow:0 8px 40px rgba(0,0,0,.18);
  overflow:hidden;
}
.chapter.active{display:flex}
.chapter-content{flex:1;display:flex;flex-direction:column;padding:36px 44px}

/* 챕터 상단 진행바 */
.ch-topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 44px;border-bottom:1px solid #F1F5F9;
  background:#FAFBFC;flex-shrink:0;
}
.ch-label-sm{font-size:9px;font-weight:700;color:var(--bc-accent);letter-spacing:.22em;text-transform:uppercase}
.ch-pagenum{font-size:9px;color:#94A3B8;font-weight:600;letter-spacing:.1em}

/* 챕터 하단 네비 */
.chapter-nav{
  padding:20px 44px;border-top:1px solid #F1F5F9;
  display:flex;align-items:center;gap:10px;flex-shrink:0;background:#FAFBFC;
}
.btn-next{
  flex:1;padding:16px 20px;border-radius:12px;border:none;cursor:pointer;
  background:var(--bc-main,#0B2545);color:#fff;
  font-size:13px;font-weight:700;font-family:var(--font);
  letter-spacing:.03em;text-align:left;
  transition:all .25s;line-height:1.5;
}
.btn-next:hover{opacity:.88;transform:translateY(-1px)}
.btn-next small{display:block;font-size:10px;font-weight:400;opacity:.7;margin-top:3px}
.btn-prev{
  width:44px;height:44px;border-radius:10px;border:1px solid #E2E8F0;
  background:#fff;color:#64748B;cursor:pointer;font-size:16px;flex-shrink:0;
}

/* ══════════════════════════════════════════════
   TOP BAR (챕터 1~8에서 표시)
══════════════════════════════════════════════ */
#topBar{
  position:sticky;top:0;z-index:100;
  max-width:800px;margin:0 auto;
  background:rgba(11,37,69,.97);backdrop-filter:blur(12px);
  padding:10px 20px;display:flex;align-items:center;gap:12px;
  box-shadow:0 2px 16px rgba(0,0,0,.3);
}
#topBar .tb-logo{font-size:12px;font-weight:800;color:#fff;letter-spacing:.08em}
#topBar .tb-bc{font-size:11px;font-weight:700;color:var(--bc-accent);margin-left:auto}
.pdots-row{display:flex;gap:5px;align-items:center}
.pdot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.2);cursor:pointer;transition:all .2s}
.pdot.done{background:var(--bc-accent);opacity:.6}
.pdot.current{background:var(--bc-accent);transform:scale(1.4)}
#printBtn{
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);
  color:rgba(255,255,255,.8);font-size:10px;padding:5px 10px;border-radius:6px;
  cursor:pointer;letter-spacing:.05em;font-family:var(--font);
}

/* ══════════════════════════════════════════════
   LOADING STATE
══════════════════════════════════════════════ */
#loadingState{
  max-width:800px;margin:40px auto;background:#fff;
  border-radius:16px;padding:60px 40px;text-align:center;
}
.spin{width:48px;height:48px;border:4px solid #E2E8F0;border-top-color:var(--sm-teal);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 24px}
@keyframes spin{to{transform:rotate(360deg)}}

/* ══════════════════════════════════════════════
   공통 섹션 타이틀
══════════════════════════════════════════════ */
.sec-title{
  font-size:11px;font-weight:800;color:var(--bc-accent);
  letter-spacing:.2em;text-transform:uppercase;
  display:flex;align-items:center;gap:8px;margin-bottom:8px;
}
.sec-title::before{content:'';width:3px;height:14px;background:var(--bc-accent);border-radius:2px;display:inline-block}
.sec-heading{font-size:20px;font-weight:900;color:#0B2545;letter-spacing:-.02em;line-height:1.3;margin-bottom:6px}
.sec-sub{font-size:12px;color:#64748B;line-height:1.7;margin-bottom:20px}

/* 팩트 박스 */
.fact-box{
  background:linear-gradient(135deg,var(--bc-bg,#E8FAF5),rgba(255,255,255,.8));
  border:1px solid var(--bc-mid,#C5F0E4);border-left:4px solid var(--bc-accent);
  border-radius:0 12px 12px 0;padding:16px 18px;margin:12px 0;
}
.fact-box .fact-label{font-size:8.5px;font-weight:800;color:var(--bc-accent);letter-spacing:.2em;text-transform:uppercase;margin-bottom:6px}
.fact-box .fact-text{font-size:12px;color:#334155;line-height:1.75;font-weight:500}
.fact-box .fact-cite{font-size:10px;color:#94A3B8;margin-top:6px;font-style:italic}

/* 다크 인사이트 박스 */
.insight-dark{
  background:var(--bc-main,#0B2545);border-radius:14px;padding:20px 22px;margin:14px 0;color:#fff;
}
.insight-dark .id-label{font-size:8.5px;font-weight:800;letter-spacing:.2em;color:rgba(255,255,255,.5);text-transform:uppercase;margin-bottom:10px}
.insight-dark .id-text{font-size:14px;font-weight:700;line-height:1.8;color:rgba(255,255,255,.95)}
.insight-dark .id-accent{color:var(--bc-accent)}

/* 카드 그리드 */
.card-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}
.card-grid.three{grid-template-columns:1fr 1fr 1fr}
.mini-card{
  background:#FAFBFC;border:1px solid #E2E8F0;border-radius:12px;padding:14px 12px;
  text-align:center;
}
.mini-card .mc-icon{font-size:22px;margin-bottom:6px}
.mini-card .mc-val{font-size:18px;font-weight:900;color:var(--bc-accent);line-height:1.1}
.mini-card .mc-label{font-size:9.5px;color:#64748B;font-weight:500;letter-spacing:.04em;margin-top:3px}

/* 스토리 텍스트 블록 */
.story-block{
  background:#F8FAFC;border-radius:14px;padding:22px 24px;margin:14px 0;
  border-left:3px solid var(--bc-accent);
}
.story-block p{font-size:13px;color:#334155;line-height:2;margin-bottom:10px}
.story-block p:last-child{margin-bottom:0}
.story-block .story-em{font-weight:700;color:var(--bc-main)}

/* 체크리스트 */
.check-list{display:flex;flex-direction:column;gap:7px;margin:12px 0}
.check-item{
  display:flex;align-items:flex-start;gap:10px;padding:12px 14px;
  background:#F8FAFC;border:1px solid #E9EEF5;border-radius:10px;
  font-size:12px;color:#334155;line-height:1.6;
}
.check-item::before{content:'✓';color:var(--bc-accent);font-weight:900;font-size:13px;flex-shrink:0;margin-top:1px}

/* 축 바 */
.axis-bar-row{display:flex;flex-direction:column;gap:2px;margin-bottom:10px}
.axis-bar-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
.axis-bar-name{font-size:11px;font-weight:700;color:#334155}
.axis-bar-score{font-size:11px;font-weight:800;color:var(--bc-accent)}
.axis-bar-track{height:8px;background:#E2E8F0;border-radius:4px;overflow:hidden}
.axis-bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--bc-accent),var(--bc-main));transition:width 1.2s cubic-bezier(.4,0,.2,1)}

/* 타임라인 */
.timeline{display:flex;flex-direction:column;gap:0;margin:14px 0;position:relative}
.timeline::before{content:'';position:absolute;left:19px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--bc-accent),var(--bc-mid))}
.tl-item{display:flex;gap:16px;padding:0 0 20px;position:relative}
.tl-dot{width:38px;height:38px;border-radius:50%;background:var(--bc-accent);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;color:#fff;position:relative;z-index:1;box-shadow:0 0 0 4px var(--bc-bg)}
.tl-body{padding-top:6px}
.tl-week{font-size:9.5px;font-weight:800;color:var(--bc-accent);letter-spacing:.12em;text-transform:uppercase;margin-bottom:3px}
.tl-title{font-size:13px;font-weight:800;color:#0B2545;margin-bottom:4px}
.tl-desc{font-size:11.5px;color:#64748B;line-height:1.7}

/* 오행 카드 */
.ohaeng-card{
  border-radius:16px;padding:22px;margin:12px 0;
  background:linear-gradient(135deg,var(--bc-main),var(--bc-accent));
  color:#fff;position:relative;overflow:hidden;
}
.ohaeng-card::after{content:'';position:absolute;right:-30px;bottom:-30px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.06)}
.ohaeng-title{font-size:10px;font-weight:800;letter-spacing:.2em;opacity:.7;text-transform:uppercase;margin-bottom:8px}
.ohaeng-name{font-size:28px;font-weight:900;letter-spacing:-.02em;margin-bottom:4px}
.ohaeng-desc{font-size:12px;opacity:.85;line-height:1.7}

/* 처방 카드 */
.rx-card{
  border:1px solid #E2E8F0;border-radius:14px;padding:16px;margin:8px 0;
  display:flex;gap:14px;align-items:flex-start;
}
.rx-icon{width:40px;height:40px;border-radius:10px;background:var(--bc-bg);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.rx-body .rx-cat{font-size:9px;font-weight:800;color:var(--bc-accent);letter-spacing:.15em;text-transform:uppercase;margin-bottom:3px}
.rx-body .rx-title{font-size:13px;font-weight:800;color:#0B2545;margin-bottom:4px}
.rx-body .rx-desc{font-size:11.5px;color:#64748B;line-height:1.7}
.rx-priority{
  font-size:9px;font-weight:700;padding:3px 8px;border-radius:20px;
  background:var(--bc-accent);color:#fff;white-space:nowrap;flex-shrink:0;
  align-self:flex-start;margin-top:2px;
}

/* 섹션 구분선 */
.sec-divider{height:1px;background:linear-gradient(90deg,var(--bc-accent),transparent);margin:22px 0;opacity:.3}

/* 논문 뱃지 */
.paper-badge{
  display:inline-flex;align-items:center;gap:5px;
  background:#F8FAFC;border:1px solid #E2E8F0;border-radius:6px;
  padding:4px 10px;font-size:9.5px;color:#64748B;margin:4px 4px 4px 0;
  font-style:italic;
}
.paper-badge::before{content:'📄';font-style:normal}

/* 히어로 숫자 */
.hero-stat{text-align:center;padding:18px 0}
.hero-stat .hs-num{font-size:64px;font-weight:900;color:var(--bc-accent);line-height:1;letter-spacing:-.04em}
.hero-stat .hs-unit{font-size:18px;font-weight:700;color:var(--bc-main);opacity:.6}
.hero-stat .hs-label{font-size:12px;color:#64748B;margin-top:6px}

/* 감정유형 뱃지 */
.emotion-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--bc-main);color:#fff;
  border-radius:30px;padding:8px 18px;font-size:12px;font-weight:700;
  margin-bottom:14px;
}
.emotion-badge .eb-type{font-size:10px;opacity:.7;margin-right:4px}

/* 클릭트리 스타일 (기존 유지 + 개선) */
.wt-wrap{margin:0}
.wt-title{font-size:13px;font-weight:800;color:#0B2545;margin-bottom:6px;display:flex;align-items:center;gap:8px}
.wt-intro{font-size:11.5px;color:#64748B;line-height:1.7;margin-bottom:16px;padding:12px 14px;background:#F8FAFC;border-radius:10px}
.wt-week-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:12px}
.wt-week-card{
  border:2px solid #E2E8F0;border-radius:12px;padding:14px;cursor:pointer;
  transition:all .2s;background:#fff;position:relative;
}
.wt-week-card:hover{border-color:var(--bc-accent);background:var(--bc-bg)}
.wt-week-card.active{border-color:var(--bc-accent);background:var(--bc-bg);box-shadow:0 4px 16px rgba(0,0,0,.08)}
.wt-week-num{font-size:9px;font-weight:800;color:var(--bc-accent);letter-spacing:.15em;text-transform:uppercase;margin-bottom:4px}
.wt-week-title{font-size:12px;font-weight:700;color:#0B2545;margin-bottom:6px;line-height:1.4}
.wt-week-badge{display:inline-block;font-size:9px;font-weight:700;padding:3px 8px;border-radius:20px}
.wt-presc-panel{display:none;padding:14px;background:#F8FAFC;border-radius:10px;margin-bottom:10px;border:1px solid #E2E8F0}
.wt-presc-panel.open{display:block;animation:fadeIn .3s ease}
.wt-axis-list{display:flex;flex-direction:column;gap:8px}
.wt-axis-item{border:1px solid #E2E8F0;border-radius:10px;overflow:hidden;background:#fff}
.wt-axis-head{
  display:flex;align-items:center;gap:10px;padding:12px 14px;cursor:pointer;
  transition:background .15s;
}
.wt-axis-head:hover{background:#F8FAFC}
.wt-axis-icon{font-size:18px}
.wt-axis-info{flex:1}
.wt-axis-name{font-size:12px;font-weight:700;color:#0B2545}
.wt-axis-prio{font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;flex-shrink:0}
.wt-axis-prio.HIGH{background:#FEF2F2;color:#DC2626}
.wt-axis-prio.MID{background:#FFF7ED;color:#EA580C}
.wt-axis-prio.LOW{background:#F0FDF4;color:#16A34A}
.wt-content-panel{display:none;padding:14px;border-top:1px solid #F1F5F9;background:#FAFBFC}
.wt-axis-item.open .wt-content-panel{display:block}
.wt-presc-text{font-size:12px;color:#334155;line-height:1.75;margin-bottom:10px}
.wt-fact-text{font-size:11px;color:#64748B;font-style:italic;margin-bottom:12px;padding-left:10px;border-left:2px solid var(--bc-accent)}
.wt-quiz{background:#F0F9FF;border-radius:10px;padding:12px;margin-bottom:10px}
.wt-quiz-q{font-size:12px;font-weight:700;color:#0B2545;margin-bottom:8px}
.wt-quiz-opts{display:flex;flex-direction:column;gap:5px}
.wt-quiz-opt{
  padding:9px 12px;border-radius:8px;border:1px solid #E2E8F0;font-size:11.5px;
  cursor:pointer;background:#fff;color:#334155;transition:all .15s;font-family:var(--font);text-align:left;
}
.wt-quiz-opt:hover{border-color:var(--bc-accent);background:var(--bc-bg)}
.wt-quiz-opt.correct{border-color:#16A34A;background:#F0FDF4;color:#166534}
.wt-quiz-opt.wrong{border-color:#DC2626;background:#FEF2F2;color:#991B1B}
.wt-quiz-feedback{font-size:11px;color:#16A34A;background:#F0FDF4;padding:8px 10px;border-radius:8px;margin-top:8px;display:none;line-height:1.6}
.wt-checkin-btn{
  width:100%;padding:11px;border-radius:10px;border:none;cursor:pointer;
  background:var(--bc-accent);color:#fff;font-size:12px;font-weight:700;
  font-family:var(--font);transition:all .2s;
}
.wt-checkin-btn:hover{opacity:.85}
.wt-checkin-done{display:none;text-align:center;padding:10px;font-size:12px;color:#16A34A;font-weight:700}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ══════════════════════════════════════════════
   인쇄
══════════════════════════════════════════════ */
@media print{
  body{background:#fff}
  .a4-wrap{padding:0;max-width:100%}
  #topBar,#loadingState,.chapter-nav,#printBtn{display:none!important}
  .chapter{display:block!important;width:210mm;min-height:auto;page-break-before:always;break-before:page;box-shadow:none;margin:0;overflow:visible}
  .chapter[data-ch="0"]{page-break-before:avoid;break-before:avoid}
  .chapter-content{padding:14mm 18mm 10mm}
  .ch-topbar{padding:8px 18mm}
  -webkit-print-color-adjust:exact;print-color-adjust:exact;color-adjust:exact;
}
</style>
</head>
<body>

<!-- TOP BAR -->
<div id="topBar" style="display:none">
  <span class="tb-logo">SlimMind</span>
  <div class="pdots-row" id="progressDots"></div>
  <span class="tb-bc" id="tbBcCode"></span>
  <button id="printBtn" onclick="printAll()">PDF 저장</button>
</div>

<!-- LOADING -->
<div id="loadingState">
  <div class="spin"></div>
  <p style="color:#64748B;font-size:14px">바디코드 분석 결과를 불러오는 중...</p>
</div>

<div class="a4-wrap" id="a4Wrap" style="display:none">


<!-- ══════════════════════════════════════════════
     COVER · 당신에게 보내는 선고문
══════════════════════════════════════════════ -->
<div class="chapter" data-ch="0" id="ch0" style="min-height:1123px;background:var(--bc-cover-grad,linear-gradient(135deg,#060D1A 0%,#0B2545 60%,#060D1A 100%));padding:0;overflow:hidden;position:relative">

  <!-- 배경 장식 -->
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;overflow:hidden">
    <!-- 상단 골드라인 -->
    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,rgba(255,215,100,.9) 30%,rgba(255,215,100,1) 50%,rgba(255,215,100,.9) 70%,transparent)"></div>
    <!-- 좌측 세로선 -->
    <div style="position:absolute;top:0;bottom:0;left:52px;width:1px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.07) 20%,rgba(255,255,255,.07) 80%,transparent)"></div>
    <!-- 우측 세로선 -->
