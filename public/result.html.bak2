        — 회원님의 맞춤 진단 결과
      </div>

      <!-- BC 코드 초대형 -->
      <div style="position:relative;margin-bottom:6px">
        <div id="cvBcCode" style="font-size:96px;font-weight:900;color:#fff;letter-spacing:-.06em;line-height:.88;animation:cvFadeUp .7s .2s cubic-bezier(.16,1,.3,1) both">BC-07</div>
        <div id="cvBcGlowText" style="position:absolute;top:0;left:0;font-size:96px;font-weight:900;color:transparent;letter-spacing:-.06em;line-height:.88;-webkit-text-stroke:1px rgba(255,255,255,.06);filter:blur(8px);pointer-events:none">BC-07</div>
      </div>

      <!-- BC 명칭 -->
      <div id="cvBcName" style="font-size:20px;font-weight:800;color:#FFD764;letter-spacing:.02em;margin-bottom:24px;text-shadow:0 2px 16px rgba(255,215,100,.3);animation:cvFadeUp .6s .32s ease both">F-FAST형 · 식욕혈당급등형</div>

      <!-- 구분선 장식 -->
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:32px;animation:cvFadeUp .6s .4s ease both">
