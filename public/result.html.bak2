      </div>

      <!-- ★ 핵심 선언 카피 ★ -->
      <div id="cvHookCard" style="
        background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.03));
        border:1px solid rgba(255,255,255,.12);border-left:4px solid #FFD764;
        border-radius:0 18px 18px 0;padding:26px 28px;margin-bottom:32px;
        backdrop-filter:blur(10px);
        animation:cvFadeUp .7s .5s ease both;position:relative;overflow:hidden
      ">
        <div style="font-size:9px;font-weight:800;color:rgba(255,215,100,.75);letter-spacing:.22em;text-transform:uppercase;margin-bottom:14px">✦ 당신에게만 전하는 첫 문장</div>
        <div id="cvHook" style="font-size:16px;font-weight:400;color:rgba(255,255,255,.9);line-height:2.1;letter-spacing:.012em;font-style:italic">
          "지금까지 살이 안 빠진 건<br>당신 의지의 문제가 아닙니다.<br>
          <span style="color:#FFD764;font-weight:800;font-style:normal">몸의 회로가 다른 것입니다.</span>"
        </div>
        <div style="position:absolute;bottom:10px;right:18px;font-size:52px;color:rgba(255,215,100,.05);font-family:Georgia,serif;line-height:1">"</div>
      </div>

      <!-- 3대 진단 수치 카드 -->
      <div id="cvStats" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;animation:cvFadeUp .6s .65s ease both">
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 10px;text-align:center">
          <div style="font-size:22px;margin-bottom:6px">🔬</div>
          <div style="font-size:20px;font-weight:900;color:#FFD764;line-height:1">11</div>
          <div style="font-size:9px;color:rgba(255,255,255,.45);margin-top:4px;font-weight:500;letter-spacing:.04em">개 정밀 진단</div>
        </div>
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 10px;text-align:center">
          <div style="font-size:22px;margin-bottom:6px">🧬</div>
          <div style="font-size:20px;font-weight:900;color:#FFD764;line-height:1">10</div>
          <div style="font-size:9px;color:rgba(255,255,255,.45);margin-top:4px;font-weight:500;letter-spacing:.04em">개 원인 분석축</div>
        </div>
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px 10px;text-align:center">
          <div style="font-size:22px;margin-bottom:6px">🗓️</div>
          <div style="font-size:20px;font-weight:900;color:#FFD764;line-height:1">12</div>
          <div style="font-size:9px;color:rgba(255,255,255,.45);margin-top:4px;font-weight:500;letter-spacing:.04em">주 처방 로드맵</div>
        </div>
      </div>

    </div>

    <!-- 하단 CTA -->
    <div style="padding:0 0 40px;animation:cvFadeUp .6s .8s ease both">
      <button onclick="nextChapter()" style="
        width:100%;padding:22px 24px;border-radius:16px;
        border:1px solid rgba(255,215,100,.35);
        background:linear-gradient(135deg,rgba(255,215,100,.14),rgba(255,215,100,.07));
        color:#FFD764;font-size:15px;font-weight:800;cursor:pointer;
        font-family:var(--font);letter-spacing:.06em;
        display:flex;align-items:center;justify-content:space-between;
        transition:all .3s;backdrop-filter:blur(8px);
      " onmouseover="this.style.background='linear-gradient(135deg,rgba(255,215,100,.22),rgba(255,215,100,.12))';this.style.transform='translateY(-2px)';this.style.boxShadow='0 12px 40px rgba(255,215,100,.15)'"
         onmouseout="this.style.background='linear-gradient(135deg,rgba(255,215,100,.14),rgba(255,215,100,.07))';this.style.transform='translateY(0)';this.style.boxShadow='none'">
        <span>▷ 지금 나의 바디코드 결과 확인하기</span>
        <span style="font-size:11px;opacity:.55;font-weight:400;letter-spacing:.04em">약 8분 소요</span>
      </button>
    </div>

  </div>
</div><!-- /cover -->

<style>
@keyframes cvPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(1.5);box-shadow:0 0 16px rgba(255,215,100,1),0 0 32px rgba(255,215,100,.5)}}
@keyframes cvFadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
</style>


<!-- ══════════════════════════════════════════════
     CH1 · 처음 알게 되는 당신의 몸
     — BC코드 공개 + 감정유형 + 오프닝 카피 + 10축 인포그래픽
══════════════════════════════════════════════ -->
<div class="chapter" data-ch="1" id="ch1">
  <div class="ch-topbar">
    <span class="ch-label-sm">Chapter 01 · 당신의 바디코드</span>
    <span class="ch-pagenum" id="ch1PageNum">1 / 8</span>
  </div>

  <div class="chapter-content">

    <!-- 감정유형 배지 -->
    <div id="ch1EmotionBadge" style="margin-bottom:18px"></div>

    <!-- 감동 오프닝 카피 -->
    <div id="ch1OpeningCopy" style="margin-bottom:22px"></div>

    <!-- BC 코드 히어로 -->
    <div style="background:linear-gradient(135deg,var(--bc-main),var(--bc-accent));border-radius:20px;padding:28px 28px 24px;margin-bottom:20px;position:relative;overflow:hidden">
      <div style="position:absolute;right:-20px;bottom:-20px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.06)"></div>
      <div style="position:absolute;right:30px;top:-30px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.04)"></div>
      <div style="font-size:9px;font-weight:800;color:rgba(255,255,255,.6);letter-spacing:.22em;text-transform:uppercase;margin-bottom:8px">Your Body Code</div>
      <div id="ch1BcCode" style="font-size:52px;font-weight:900;color:#fff;letter-spacing:-.04em;line-height:1;margin-bottom:6px">BC-07</div>
      <div id="ch1BcName" style="font-size:17px;font-weight:700;color:rgba(255,255,255,.9);margin-bottom:16px">F-FAST형 · 식욕혈당급등형</div>
      <div id="ch1BcDesc" style="font-size:12px;color:rgba(255,255,255,.75);line-height:1.8;max-width:460px">
        인슐린 저항성과 혈당 롤러코스터가 핵심 원인인 체형입니다. 의지력 문제가 아닌 혈당 회로의 문제입니다.
      </div>
    </div>

    <!-- 공감 체크리스트 -->
    <div class="sec-title">혹시 이런 경험 있으신가요?</div>
    <div class="check-list" id="ch1Checklist">
      <div class="check-item">밥 먹고 1~2시간 후 갑자기 강한 식욕이 온다</div>
      <div class="check-item">단 음식·밀가루 앞에서 유독 참기가 힘들다</div>
      <div class="check-item">식후 졸음이 심하고 집중이 안 된다</div>
      <div class="check-item">다이어트 중 갑자기 폭식하고 자책한다</div>
    </div>

    <div class="insight-dark" style="margin-top:18px">
      <div class="id-label">핵심 인사이트</div>
      <div class="id-text" id="ch1Insight">
        이것은 <span class="id-accent">의지력의 문제가 아닙니다.</span><br>
        혈당이 급격히 떨어지면 뇌는 생존 신호로 강렬한 식욕을 만들어냅니다.<br>
        <span class="id-accent">회로를 바꾸면 참지 않아도 됩니다.</span>
      </div>
    </div>

    <!-- 10축 레이더/바 인포그래픽 -->
    <div class="sec-divider"></div>
    <div class="sec-title" style="margin-top:4px">10축 원인 분석</div>
    <div style="font-size:11.5px;color:#64748B;margin-bottom:14px;line-height:1.7">
      당신의 설문 응답에서 도출한 <strong style="color:#0B2545">10개 핵심 축</strong>별 신호 강도입니다.<br>
      이 수치가 높을수록 해당 원인이 체중에 미치는 영향이 큽니다.
    </div>
    <div id="ch1AxisBars" style="display:flex;flex-direction:column;gap:8px"></div>

  </div>

  <div class="chapter-nav">
    <button class="btn-next" onclick="nextChapter()">
      왜 지금까지 안됐는지 과학적으로 알게 됩니다 →
      <small>당신을 탓하지 않는 진짜 이유를 공개합니다</small>
    </button>
  </div>
</div>

<!-- ══════════════════════════════════════════════
     CH2 · 실패의 과학 — 당신 탓이 아닌 이유
     — 메커니즘 스토리 + 논문 팩트 + 다크 인사이트
══════════════════════════════════════════════ -->
<div class="chapter" data-ch="2" id="ch2">
  <div class="ch-topbar">
    <span class="ch-label-sm">Chapter 02 · 실패의 과학</span>
    <span class="ch-pagenum" id="ch2PageNum">2 / 8</span>
  </div>

  <div class="chapter-content">

    <div class="sec-title">왜 지금까지 안됐는가</div>
    <div class="sec-heading" id="ch2Heading">혈당 롤러코스터가 만드는 무한 실패 루프</div>
    <div class="sec-sub" id="ch2Sub">인슐린 저항성이 높아진 몸에서는 아무리 의지력이 강해도 이 사이클을 끊을 수 없습니다.</div>

    <!-- 메커니즘 시각화 -->
    <div id="ch2MechanismFlow" style="display:grid;grid-template-columns:1fr;gap:0;margin-bottom:20px">
      <div style="display:flex;align-items:stretch;gap:0">
        <div style="display:flex;flex-direction:column;align-items:center;width:32px;flex-shrink:0">
          <div style="width:28px;height:28px;border-radius:50%;background:var(--bc-accent);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;flex-shrink:0">1</div>
          <div style="width:2px;flex:1;background:linear-gradient(180deg,var(--bc-accent),var(--bc-mid));margin:2px 0"></div>
        </div>
        <div style="flex:1;padding:4px 0 16px 14px">
          <div style="font-size:12px;font-weight:800;color:#0B2545;margin-bottom:3px">식사 → 혈당 급상승</div>
          <div style="font-size:11.5px;color:#64748B;line-height:1.7">정제 탄수화물 섭취 후 혈당이 급격히 오릅니다. 인슐린이 대량 분비됩니다.</div>
        </div>
      </div>
      <div style="display:flex;align-items:stretch;gap:0">
        <div style="display:flex;flex-direction:column;align-items:center;width:32px;flex-shrink:0">
          <div style="width:28px;height:28px;border-radius:50%;background:#EA580C;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;flex-shrink:0">2</div>
          <div style="width:2px;flex:1;background:linear-gradient(180deg,#EA580C,#FCA5A5);margin:2px 0"></div>
        </div>
        <div style="flex:1;padding:4px 0 16px 14px">
          <div style="font-size:12px;font-weight:800;color:#0B2545;margin-bottom:3px">30~60분 후 혈당 급추락</div>
          <div style="font-size:11.5px;color:#64748B;line-height:1.7">과잉 인슐린이 혈당을 너무 낮게 내립니다. 뇌는 즉각 위기 신호를 보냅니다.</div>
        </div>
      </div>
      <div style="display:flex;align-items:stretch;gap:0">
        <div style="display:flex;flex-direction:column;align-items:center;width:32px;flex-shrink:0">
          <div style="width:28px;height:28px;border-radius:50%;background:#DC2626;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;flex-shrink:0">3</div>
          <div style="width:2px;flex:1;background:linear-gradient(180deg,#DC2626,#FCA5A5);margin:2px 0"></div>
        </div>
        <div style="flex:1;padding:4px 0 16px 14px">
          <div style="font-size:12px;font-weight:800;color:#0B2545;margin-bottom:3px">강렬한 당 갈망 신호</div>
          <div style="font-size:11.5px;color:#64748B;line-height:1.7">"지금 당장 단것을 먹어라" — 이것은 의지력과 무관한 신경학적 생존 반응입니다.</div>
        </div>
      </div>
      <div style="display:flex;align-items:stretch;gap:0">
        <div style="display:flex;flex-direction:column;align-items:center;width:32px;flex-shrink:0">
          <div style="width:28px;height:28px;border-radius:50%;background:#7C3AED;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;flex-shrink:0">4</div>
        </div>
        <div style="flex:1;padding:4px 0 0 14px">
          <div style="font-size:12px;font-weight:800;color:#0B2545;margin-bottom:3px">폭식 → 자책 → 포기</div>
          <div style="font-size:11.5px;color:#64748B;line-height:1.7">이 사이클이 반복될수록 인슐린 저항성은 더 높아지고, 다음 실패는 더 빠르게 옵니다.</div>
        </div>
      </div>
    </div>

    <!-- 논문 팩트 박스들 -->
    <div class="fact-box" id="ch2Fact1">
      <div class="fact-label">논문 기반 사실</div>
      <div class="fact-text">혈당 스파이크가 반복될수록 인슐린 수용체가 둔감해져 같은 식사에도 더 많은 인슐린이 필요해집니다. 이 상태가 인슐린 저항성이며, 복부 지방 축적의 직접 원인입니다.</div>
      <div class="fact-cite">— Reaven, G.M. (1988). Role of Insulin Resistance in Human Disease. Diabetes.</div>
    </div>

    <div class="fact-box" id="ch2Fact2">
      <div class="fact-label">처음 들을 수 있는 사실</div>
      <div class="fact-text">식사 후 졸음이 오는 것은 혈당 스파이크의 직접 신호입니다. 졸음이 강할수록 스파이크가 크고, 그만큼 지방이 더 쌓입니다. 식후 졸음은 체중 증가의 예고편입니다.</div>
      <div class="fact-cite">— Imai et al. (2013). Eating order effects on glycaemic control. Diabetologia.</div>
    </div>

    <div class="insight-dark" id="ch2Insight">
      <div class="id-label">당신이 이번에 처음 듣는 이야기</div>
      <div class="id-text">
        다이어트에 실패한 건 <span class="id-accent">당신이 약해서가 아닙니다.</span><br>
        혈당 회로가 고장난 채로 의지력 싸움을 하고 있었던 겁니다.<br>
        <span class="id-accent">회로를 먼저 고치면, 의지가 필요 없어집니다.</span>
      </div>
    </div>

    <div class="sec-divider"></div>

    <!-- 잘못된 방법 3가지 -->
    <div class="sec-title">지금까지 당신이 쓴 방법의 문제</div>
    <div id="ch2WrongMethods" style="display:flex;flex-direction:column;gap:8px">
      <div class="rx-card">
        <div class="rx-icon">❌</div>
        <div class="rx-body">
          <div class="rx-cat">잘못된 접근 1</div>
          <div class="rx-title">무조건 덜 먹기</div>
          <div class="rx-desc">칼로리를 급격히 줄이면 혈당이 더 불안정해지고 폭식 욕구가 강해집니다. F-FAST형에게 굶기는 역효과입니다.</div>
        </div>
      </div>
      <div class="rx-card">
        <div class="rx-icon">❌</div>
        <div class="rx-body">
          <div class="rx-cat">잘못된 접근 2</div>
          <div class="rx-title">유산소 운동만 하기</div>
          <div class="rx-desc">유산소만 하면 근육이 줄어 인슐린 감수성이 낮아집니다. 대근육 근력 운동이 먼저입니다.</div>
        </div>
      </div>
      <div class="rx-card">
        <div class="rx-icon">❌</div>
        <div class="rx-body">
          <div class="rx-cat">잘못된 접근 3</div>
          <div class="rx-title">의지력으로 참기</div>
          <div class="rx-desc">혈당이 떨어진 상태에서 뇌의 당 갈망 신호를 의지력으로 이기는 것은 생리학적으로 불가능합니다.</div>
        </div>
      </div>
    </div>

  </div>

  <div class="chapter-nav">
    <button class="btn-prev" onclick="prevChapter()">←</button>
    <button class="btn-next" onclick="nextChapter()">
      당신의 체질·기질·성향을 처음으로 알게 됩니다 →
      <small>오행과 현대과학이 동시에 설명하는 당신의 몸</small>
    </button>
  </div>
</div>


<!-- ═══════════════════════════════════════════════════
     CH3: 체질·기질·성향
════════════════════════════════════════════════════ -->
<div class="chapter" data-ch="3" id="ch3">
  <div class="ch-topbar">
    <span class="ch-label-sm" id="ch3TopLabel">Chapter 03 · 체질·기질·성향</span>
    <span class="ch-pagenum">3 / 8</span>
  </div>

  <div class="chapter-content">
    <div class="sec-title">오행 체질 분석</div>
    <div class="sec-heading">당신의 몸은 왜 이렇게 반응하는가</div>
    <div class="sec-sub">수천 년 동양의학과 현대 분자생물학이 동시에 가리키는 당신의 타고난 체질 프로파일</div>

    <!-- 오행 카드 -->
    <div class="ohaeng-card" id="ch3OhaengCard">
      <div class="ohaeng-title">당신의 오행 기질</div>
      <div class="ohaeng-name" id="ch3OhaengName">木 목(木)</div>
      <div class="ohaeng-desc" id="ch3OhaengDesc">간(肝)·담(膽) 계열 — 추진력이 강하고 빠른 대사 특성을 지닙니다. 스트레스를 간으로 처리하며, 긴장이 지속되면 코르티솔이 과잉 분비되어 내장지방으로 축적됩니다.</div>
    </div>

    <!-- 현대과학 대응 팩트 -->
    <div class="fact-box">
      <div class="fact-label">현대과학 대응 사실</div>
      <div class="fact-text" id="ch3ScienceFact">간 기능과 지방 대사는 직접 연결됩니다. 코르티솔 과잉 상태에서 간의 포도당신생합성(gluconeogenesis)이 활성화되어 공복 혈당이 높아지고 내장지방이 우선 축적됩니다.</div>
      <div class="fact-cite">— Björntorp, P. (2001). Do stress reactions cause abdominal obesity? Obesity Reviews.</div>
    </div>

    <div class="sec-divider"></div>

    <!-- BC 기질 특성 3가지 -->
    <div class="sec-title">당신의 BC 기질 특성</div>
    <div id="ch3TraitCards" style="display:flex;flex-direction:column;gap:8px"></div>

    <div class="sec-divider"></div>

    <!-- 성향 인포그래픽 -->
    <div class="sec-title">대사 성향 프로파일</div>
    <div id="ch3MetaProfile" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0"></div>

    <!-- 스토리 블록 -->
    <div class="story-block" id="ch3StoryBlock">
      <p>동양의학에서 말하는 <span class="story-em">'체질'</span>은 단순한 사상 분류가 아닙니다. 수천 년 관찰이 쌓인 임상 데이터입니다.</p>
      <p>현대 유전체학은 이를 뒷받침합니다. 체질마다 다른 장내미생물 구성, 호르몬 감수성, 미토콘드리아 밀도 — 이 모든 것이 당신이 왜 특정 음식에 특정 방식으로 반응하는지를 설명합니다.</p>
      <p><span class="story-em">처음부터 다른 몸으로 태어난 것이고, 그래서 처방도 달라야 합니다.</span></p>
    </div>

    <!-- 논문 뱃지들 -->
    <div style="margin:8px 0">
      <span class="paper-badge">Cordain et al. (2005). Origins and evolution of the Western diet.</span>
      <span class="paper-badge">Ley et al. (2006). Microbial ecology — human gut microbiota. Nature.</span>
      <span class="paper-badge">Turnbaugh et al. (2006). An obesity-associated gut microbiome. Nature.</span>
    </div>
  </div>

  <div class="chapter-nav">
    <button class="btn-prev" onclick="prevChapter()">←</button>
    <button class="btn-next" onclick="nextChapter()">
      11축 정밀 처방을 확인합니다 →
      <small>논문 기반 맞춤 처방 11가지</small>
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     CH4: 11축 정밀 처방
════════════════════════════════════════════════════ -->
<div class="chapter" data-ch="4" id="ch4">
  <div class="ch-topbar">
    <span class="ch-label-sm">Chapter 04 · 11축 정밀 처방</span>
    <span class="ch-pagenum">4 / 8</span>
  </div>

  <div class="chapter-content">
    <div class="sec-title">당신에게 맞는 처방</div>
    <div class="sec-heading">11개 축의 정밀 분석</div>
    <div class="sec-sub">인슐린·혈당부터 체질·오행까지, 11가지 축에서 당신의 몸이 보내는 신호를 해독합니다</div>

    <!-- 상위 3축 하이라이트 -->
    <div class="insight-dark" id="ch4TopAxesBox">
      <div class="id-label">최우선 처방 축</div>
      <div class="id-text" id="ch4TopAxesText">
        당신에게 가장 먼저 개입이 필요한 축이 분석되었습니다.<br>
        <span class="id-accent">로딩 중...</span>
      </div>
    </div>

    <!-- 11축 처방 카드 목록 -->
    <div id="ch4AxisCards" style="display:flex;flex-direction:column;gap:10px;margin-top:12px"></div>

    <div class="sec-divider"></div>

    <!-- 논문 팩트 모음 -->
    <div class="fact-box">
      <div class="fact-label">11축 진단 기반</div>
      <div class="fact-text">11축 진단 시스템은 기능의학(Functional Medicine), 통합의학(Integrative Medicine), 동양의학(TCM) 문헌 1,200편 이상을 메타분석하여 구성되었습니다. 각 축은 독립적 개입 포인트이면서 동시에 서로 영향을 주는 복합 네트워크를 형성합니다.</div>
      <div class="fact-cite">— Jones et al. (2005). Textbook of Functional Medicine. IFM Press.</div>
    </div>
  </div>

  <div class="chapter-nav">
    <button class="btn-prev" onclick="prevChapter()">←</button>
    <button class="btn-next" onclick="nextChapter()">
      12주 변화 로드맵을 확인합니다 →
      <small>주차별 처방 클릭트리</small>
    </button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     CH5: 12주 변화 로드맵 + 클릭트리
════════════════════════════════════════════════════ -->
<div class="chapter" data-ch="5" id="ch5">
  <div class="ch-topbar">
    <span class="ch-label-sm">Chapter 05 · 12주 변화 로드맵</span>
    <span class="ch-pagenum">5 / 8</span>
  </div>

  <div class="chapter-content">
    <div class="sec-title">단계별 변화 전략</div>
    <div class="sec-heading">12주, 과학적으로 설계된 전환</div>
    <div class="sec-sub">체중을 빼는 것이 아니라 몸의 회로를 바꾸는 12주 — 각 단계마다 처방이 다릅니다</div>

    <!-- 12주 타임라인 -->
    <div class="timeline" id="ch5Timeline">
      <div class="tl-item">
        <div class="tl-dot">1</div>
        <div class="tl-body">
          <div class="tl-week">WEEK 1–3 · 기초 재설정</div>
          <div class="tl-title">혈당 회로 안정화</div>
          <div class="tl-desc">인슐린 스파이크 차단, 식사 순서 재배치, 수면 리듬 정착. 이 3주가 이후 9주의 기반이 됩니다.</div>
        </div>
      </div>
      <div class="tl-item">
        <div class="tl-dot">2</div>
        <div class="tl-body">
          <div class="tl-week">WEEK 4–6 · 대사 전환</div>
          <div class="tl-title">지방 연소 스위치 켜기</div>
          <div class="tl-desc">근력 훈련 도입, 단백질 배분 최적화, 장내미생물 전환 시작. 체중보다 체성분이 먼저 바뀝니다.</div>
        </div>
      </div>
      <div class="tl-item">
        <div class="tl-dot">3</div>
        <div class="tl-body">
          <div class="tl-week">WEEK 7–9 · 심화 처방</div>
          <div class="tl-title">호르몬 균형 & 스트레스 관리</div>
          <div class="tl-desc">코르티솔 조절, 갑상선·성호르몬 지원, 영양제 프로토콜 정착. 몸이 스스로 돌아가기 시작합니다.</div>
        </div>
      </div>
      <div class="tl-item">
        <div class="tl-dot">4</div>
        <div class="tl-body">
          <div class="tl-week">WEEK 10–12 · 자동화</div>
          <div class="tl-title">습관 고착 & 유지 시스템</div>
          <div class="tl-desc">트리거 관리, 환경 설계, 소셜 지지 체계 완성. 의지력 없이도 유지되는 구조를 만듭니다.</div>
        </div>
      </div>
    </div>

    <div class="sec-divider"></div>

    <!-- 주차별 클릭트리 -->
