      <div style="display:flex;align-items:center;gap:10px;margin-bottom:28px">
        <div id="cvPulseDot" style="width:8px;height:8px;border-radius:50%;background:#FFD764;box-shadow:0 0 12px rgba(255,215,100,.8),0 0 24px rgba(255,215,100,.3);animation:cvPulse 2.4s ease-in-out infinite"></div>
