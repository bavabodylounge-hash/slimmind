/* ─────────────────────────────────
   6. 챕터 네비게이션
───────────────────────────────── */
let currentChapter = 0;
const TOTAL_CH = 9; // 0~8

function gotoChapter(n) {
  const chapters = document.querySelectorAll('.chapter');
  chapters.forEach(c => c.classList.remove('active'));
  if (chapters[n]) chapters[n].classList.add('active');
  currentChapter = n;
  updateTopBar(n);
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function nextChapter() {
  if (currentChapter < TOTAL_CH - 1) gotoChapter(currentChapter + 1);
}

function prevChapter() {
  if (currentChapter > 0) gotoChapter(currentChapter - 1);
}

function updateTopBar(n) {
  const bar = document.getElementById('topBar');
  if (!bar) return;
  bar.style.display = n > 0 ? 'flex' : 'none';
  const dots = document.getElementById('progressDots');
  if (dots) {
    dots.innerHTML = '';
    for (let i = 1; i <= 8; i++) {
      const d = document.createElement('div');
      d.className = 'pdot' + (i < n ? ' done' : '') + (i === n ? ' current' : '');
      d.onclick = () => gotoChapter(i);
      dots.appendChild(d);
    }
  }
}

function printAll() {
  window.print();
}

/* ─────────────────────────────────
   7. BC 색상 테마 적용
───────────────────────────────── */
function applyBcColorTheme(bcCode) {
  document.body.className = document.body.className.replace(/bc-theme-BC-\d+/g, '');
  document.body.classList.add('bc-theme-' + bcCode);
  const tbBc = document.getElementById('tbBcCode');
  if (tbBc) tbBc.textContent = bcCode;
}

/* ─────────────────────────────────
   8. 커버 렌더링
───────────────────────────────── */
function renderCover(res, bc) {
  const el = id => document.getElementById(id);
  const safeSet = (elId, val) => { const e = el(elId); if (e) e.textContent = val || ''; };
  const safeHtml = (elId, val) => { const e = el(elId); if (e) e.innerHTML = val || ''; };

  safeSet('coverName', (res.name || '회원') + '님');
  safeSet('coverBcCode', bc || 'BC-01');
  safeSet('coverBcName', (BC_DB[bc] || {}).name || '');
  const date = new Date();
  safeSet('coverDate', `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')}`);

  // 훅카피
  const eType = classifyEmotionType(res);
  const copy = (OPENING_COPY_MATRIX[eType] || OPENING_COPY_MATRIX['E-07'])[bc] || OPENING_COPY_MATRIX['E-07']['BC-01'];
  safeHtml('coverHookCopy', `<div style="font-size:16px;font-weight:900;line-height:1.5;margin-bottom:8px">${copy.headline}</div><div style="font-size:12px;opacity:.8;line-height:1.7">${copy.body}</div>`);

  // 3대 수치 카드 (응답 데이터에서)
  const bmi = res.bmi ? `${Number(res.bmi).toFixed(1)}` : '—';
  const age = res.age || '—';
  const week = res.targetWeeks || '12';
  safeHtml('coverStats', `
    <div class="cov-stat"><div class="cs-num">${bmi}</div><div class="cs-label">BMI</div></div>
    <div class="cov-stat"><div class="cs-num">${age}</div><div class="cs-label">나이</div></div>
    <div class="cov-stat"><div class="cs-num">${week}주</div><div class="cs-label">목표 기간</div></div>
  `);
}

/* ─────────────────────────────────
   9. CH1 렌더링
───────────────────────────────── */
function renderCh1(res, bc) {
  const eType = classifyEmotionType(res);
  const copy = (OPENING_COPY_MATRIX[eType] || OPENING_COPY_MATRIX['E-07'])[bc] || OPENING_COPY_MATRIX['E-07']['BC-01'];
  const bcData = BC_DB[bc] || BC_DB['BC-01'];

  const safeHtml = (elId, val) => { const e = document.getElementById(elId); if (e) e.innerHTML = val || ''; };
  const safeSet = (elId, val) => { const e = document.getElementById(elId); if (e) e.textContent = val || ''; };

  // 감정유형 배지
  const eLabels = {'E-01':'스트레스+수면 부족','E-02':'폭식·자책','E-03':'만성 피로','E-04':'당·탄수 갈망','E-05':'사회적 섭식','E-06':'불안·감정 섭식','E-07':'패턴 분석형'};
  safeHtml('ch1EmotionBadge', `<span class="emotion-badge"><span class="eb-type">${eType}</span>${eLabels[eType]||eType}</span>`);

  // 오프닝 카피
  safeHtml('ch1OpeningCopy', `
    <div style="font-size:9px;font-weight:800;color:var(--bc-accent);letter-spacing:.2em;margin-bottom:10px">당신에게 처음으로 전하는 말</div>
    <div style="font-size:18px;font-weight:900;color:#fff;line-height:1.45;margin-bottom:10px">${copy.headline}</div>
    <div style="font-size:12.5px;color:rgba(255,255,255,.85);line-height:1.8;margin-bottom:12px">${copy.body}</div>
    <div style="font-size:11.5px;color:var(--bc-accent);font-weight:700;margin-bottom:6px">💡 ${copy.insight}</div>
    <div style="font-size:11px;color:rgba(255,255,255,.7)">▶ ${copy.action}</div>
  `);

  // BC 히어로 카드
  safeHtml('ch1BcHero', `
    <div style="font-size:9px;font-weight:800;letter-spacing:.25em;color:var(--bc-accent);text-transform:uppercase;margin-bottom:8px">Your Body Code</div>
    <div style="font-size:52px;font-weight:900;color:var(--bc-accent);letter-spacing:.03em;line-height:1;margin-bottom:6px">${bc}</div>
    <div style="font-size:18px;font-weight:700;color:#fff;margin-bottom:10px">${bcData.name}</div>
    <div style="font-size:12px;color:rgba(255,255,255,.75);line-height:1.7">${bcData.ohaengDesc}</div>
  `);

  // 체크리스트
  const checkItems = [
    '지금까지의 방법이 효과가 없었던 건 의지력 때문이 아닙니다',
    '당신의 BC 코드가 이유를 과학적으로 설명합니다',
    '이 처방은 당신의 몸에만 맞게 설계된 것입니다',
    '12주가 지나면 몸의 작동 방식이 근본적으로 바뀝니다'
  ];
  safeHtml('ch1Checklist', `<div class="check-list">${checkItems.map(i=>`<div class="check-item">${i}</div>`).join('')}</div>`);

  // 인사이트 다크박스
  safeSet('ch1InsightText', copy.insight);

  // 10축 바
  const axisScores = {'A1':85,'A2':70,'A3':60,'A4':75,'A5':55,'A6':65,'A7':50,'A8':60,'A9':70,'A10':65,'A11':80};
  const topAxes = (bcData.topAxes || ['A1','A4','A11']);
  const axisBarsHtml = AXIS_DEFS.map(a => {
    const score = topAxes.includes(a.id) ? (70 + Math.floor(Math.random()*25)) : (40 + Math.floor(Math.random()*30));
    return `<div class="axis-bar-row">
      <div class="axis-bar-label"><span class="axis-bar-name">${a.icon} ${a.name}</span><span class="axis-bar-score">${score}%</span></div>
      <div class="axis-bar-track"><div class="axis-bar-fill" style="width:${score}%"></div></div>
    </div>`;
  }).join('');
  safeHtml('ch1AxisBars', `<div style="display:flex;flex-direction:column;gap:6px">${axisBarsHtml}</div>`);
}

/* ─────────────────────────────────
   10. CH3 렌더링 (체질·기질·성향)
───────────────────────────────── */
function renderCh3(bc) {
  const bcData = BC_DB[bc] || BC_DB['BC-01'];
  const safeSet = (id, v) => { const e = document.getElementById(id); if(e) e.textContent = v||''; };
  const safeHtml = (id, v) => { const e = document.getElementById(id); if(e) e.innerHTML = v||''; };

  safeSet('ch3OhaengName', bcData.ohaeng || '');
  safeSet('ch3OhaengDesc', bcData.ohaengDesc || '');
  safeSet('ch3ScienceFact', bcData.scienceFact || '');

  // 기질 특성 카드
  safeHtml('ch3TraitCards', (bcData.traits||[]).map((t,i)=>`
    <div class="check-item" style="background:var(--bc-bg);border-color:var(--bc-mid)">
      <span style="font-size:11px;font-weight:800;color:var(--bc-accent);margin-right:4px">${i+1}.</span>${t}
    </div>`).join(''));

  // 대사 성향 프로파일
  safeHtml('ch3MetaProfile', (bcData.metaProfile||[]).map(m=>`
    <div class="mini-card">
      <div class="mc-icon">${m.icon||'📊'}</div>
      <div class="mc-val">${m.val||''}</div>
      <div class="mc-label">${m.label||''}</div>
    </div>`).join(''));
}

/* ─────────────────────────────────
   11. CH4 렌더링 (11축 정밀 처방)
───────────────────────────────── */
function renderCh4(bc) {
  const bcData = BC_DB[bc] || BC_DB['BC-01'];
  const topAxes = bcData.topAxes || ['A1','A4','A11'];
  const safeHtml = (id, v) => { const e = document.getElementById(id); if(e) e.innerHTML = v||''; };

  // 상위 3축 텍스트
  safeHtml('ch4TopAxesText', `
    당신의 가장 강력한 개입 포인트:<br>
    <span class="id-accent">${topAxes.join(' → ')}</span><br>
    이 3축을 먼저 잡으면 나머지가 연쇄적으로 개선됩니다.
  `);

  // 11축 처방 카드
  const priorityAxesSet = new Set(topAxes);
  safeHtml('ch4AxisCards', AXIS_DEFS.map(a => {
    const isTop = priorityAxesSet.has(a.id);
    const prioLabel = isTop ? '최우선' : '보조';
    const prioColor = isTop ? 'var(--bc-accent)' : '#94A3B8';
    return `<div class="rx-card" style="${isTop?'border-color:var(--bc-accent);background:var(--bc-bg)':''}">
      <div class="rx-icon">${a.icon}</div>
      <div class="rx-body" style="flex:1">
        <div class="rx-cat">${a.id} · ${a.name}</div>
        <div class="rx-title" style="font-size:12px">${a.desc}</div>
        <div class="rx-desc" style="font-style:italic;color:#94A3B8;font-size:10.5px;margin-top:4px">${a.fact}</div>
      </div>
      <div class="rx-priority" style="background:${isTop?'var(--bc-accent)':'#E2E8F0'};color:${isTop?'#fff':'#64748B'}">${prioLabel}</div>
    </div>`;
  }).join(''));
}

/* ─────────────────────────────────
   12. CH5 클릭트리 렌더링
───────────────────────────────── */
let selectedWeek = null;

function renderWeeklyClickTree(res, bc) {
  const tree = defaultWeeklyTree;
  const grid = document.getElementById('wtWeekGrid');
  if (!grid) return;

  grid.innerHTML = tree.map((w, wi) => `
    <div class="wt-week-card" id="wt-week-${wi}" onclick="wtToggleWeek(${wi})">
      <div class="wt-week-num">${w.weekRange}</div>
      <div class="wt-week-title">${w.weekTitle}</div>
      <div class="wt-week-badge" style="background:${w.badgeColor};color:#374151">${w.badge}</div>
    </div>
  `).join('');
}

function wtToggleWeek(wi) {
  const tree = defaultWeeklyTree;
  const panel = document.getElementById('wtPrescPanel');
  if (!panel) return;

  document.querySelectorAll('.wt-week-card').forEach((c,i) => {
    c.classList.toggle('active', i === wi);
  });

  if (selectedWeek === wi) {
    panel.classList.remove('open');
    selectedWeek = null;
    return;
  }
  selectedWeek = wi;
  const w = tree[wi];
  panel.innerHTML = `
    <div style="font-size:11px;font-weight:800;color:var(--bc-accent);letter-spacing:.1em;margin-bottom:10px">${w.weekRange} · ${w.weekTitle}</div>
    <div class="wt-axis-list">${w.axes.map((a,ai) => `
      <div class="wt-axis-item" id="wt-axis-${wi}-${ai}">
        <div class="wt-axis-head" onclick="wtToggleAxis(${wi},${ai})">
          <span class="wt-axis-icon">${a.icon}</span>
          <div class="wt-axis-info">
            <div class="wt-axis-name">${a.id} · ${a.name}</div>
          </div>
          <span class="wt-axis-prio ${a.priority}">${a.priority === 'HIGH' ? '핵심' : a.priority === 'MID' ? '중요' : '보조'}</span>
        </div>
        <div class="wt-content-panel">
          <div class="wt-presc-text">${a.presc}</div>
          <div class="wt-fact-text">${a.fact}</div>
          ${a.quiz ? `<div class="wt-quiz" id="quiz-${wi}-${ai}">
            <div class="wt-quiz-q">🧠 ${a.quiz.q}</div>
            <div class="wt-quiz-opts">${a.quiz.opts.map((o,oi)=>`
              <button class="wt-quiz-opt" onclick="wtAnswer(${wi},${ai},${oi},${a.quiz.correct})">${o}</button>
            `).join('')}</div>
            <div class="wt-quiz-feedback" id="qf-${wi}-${ai}">${a.quiz.feedback}</div>
          </div>` : ''}
          <button class="wt-checkin-btn" onclick="wtCheckin(${wi},${ai},'${w.weekRange}','${a.id}')">✓ 이 처방 체크인</button>
          <div class="wt-checkin-done" id="wd-${wi}-${ai}">✅ 체크인 완료!</div>
        </div>
      </div>
    `).join('')}</div>
  `;
  panel.classList.add('open');
}

function wtToggleAxis(wi, ai) {
  const item = document.getElementById(`wt-axis-${wi}-${ai}`);
  if (item) item.classList.toggle('open');
}

function wtAnswer(wi, ai, chosen, correct) {
  const quiz = document.getElementById(`quiz-${wi}-${ai}`);
  if (!quiz) return;
  const opts = quiz.querySelectorAll('.wt-quiz-opt');
  opts.forEach((o, i) => {
    o.disabled = true;
    if (i === correct) o.classList.add('correct');
    else if (i === chosen && chosen !== correct) o.classList.add('wrong');
  });
  const fb = document.getElementById(`qf-${wi}-${ai}`);
  if (fb) fb.style.display = 'block';
}

function wtCheckin(wi, ai, weekRange, axisId) {
  const btn = document.querySelector(`#wt-axis-${wi}-${ai} .wt-checkin-btn`);
  const done = document.getElementById(`wd-${wi}-${ai}`);
  if (btn) btn.style.display = 'none';
  if (done) done.style.display = 'block';

  const params = new URLSearchParams(window.location.search);
  const resultId = params.get('id') || params.get('result_id') || '';
  const consultantCode = params.get('ref') || '';
  const bcCode = window._bcCode || '';

  fetch('/api/checkin', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ result_id: resultId, consultant_code: consultantCode, bc_code: bcCode, week_range: weekRange, axis_name: axisId })
  }).catch(() => {});
}

/* ─────────────────────────────────
   13. CH6 렌더링 (식단·운동·영양제)
───────────────────────────────── */
function renderCh6(bc) {
  const bcData = BC_DB[bc] || BC_DB['BC-01'];
  const safeHtml = (id, v) => { const e = document.getElementById(id); if(e) e.innerHTML = v||''; };
  const rxCard = (item) => `
    <div class="rx-card">
      <div class="rx-icon">${item.icon}</div>
      <div class="rx-body">
        <div class="rx-cat">${item.cat}</div>
        <div class="rx-title">${item.title}</div>
        <div class="rx-desc">${item.desc}</div>
      </div>
    </div>`;
  safeHtml('ch6DietCards', (bcData.diet||[]).map(rxCard).join(''));
  safeHtml('ch6ExerciseCards', (bcData.exercise||[]).map(rxCard).join(''));
  safeHtml('ch6SupplCards', (bcData.suppl||[]).map(rxCard).join(''));
}

/* ─────────────────────────────────
   14. CH7 렌더링 (오행 계절 처방)
───────────────────────────────── */
function renderCh7(bc) {
  const safeHtml = (id, v) => { const e = document.getElementById(id); if(e) e.innerHTML = v||''; };
  const bcData = BC_DB[bc] || BC_DB['BC-01'];

  const seasons = [
    {name:'봄 · 木', icon:'🌸', ohaeng:'목(木)', desc:'간·담 기능 활성. 해독과 시작의 계절. 새순채소·발아식품을 늘리고 과로를 피합니다.', color:'#D1FAE5'},
    {name:'여름 · 火', icon:'☀️', ohaeng:'화(火)', desc:'심장·소장 기능 활성. 수분과 전해질 관리가 핵심. 과도한 땀 배출에 주의합니다.', color:'#FEE2E2'},
    {name:'장하 · 土', icon:'🌻', ohaeng:'토(土)', desc:'비·위 기능 활성. 소화력이 연중 가장 강합니다. 단, 습기가 소화를 방해할 수 있습니다.', color:'#FEF9C3'},
    {name:'가을 · 金', icon:'🍂', ohaeng:'금(金)', desc:'폐·대장 기능 활성. 건조함에 취약. 수분 보충과 장 건강이 우선입니다.', color:'#FDE68A'},
    {name:'겨울 · 水', icon:'❄️', ohaeng:'수(水)', desc:'신장·방광 기능 활성. 에너지 저장의 계절. 과도한 소모를 피하고 보온에 신경 씁니다.', color:'#DBEAFE'}
  ];

  safeHtml('ch7SeasonCards', seasons.map(s=>`
    <div style="background:${s.color};border-radius:14px;padding:16px;border:1px solid rgba(0,0,0,.06)">
      <div style="font-size:22px;margin-bottom:6px">${s.icon}</div>
      <div style="font-size:12px;font-weight:800;color:#0B2545;margin-bottom:4px">${s.name}</div>
      <div style="font-size:11px;color:#334155;line-height:1.7">${s.desc}</div>
    </div>`).join(''));

  // 현재 계절 판단
  const m = new Date().getMonth()+1;
  let curSeason;
  if(m>=3&&m<=5) curSeason=seasons[0];
  else if(m>=6&&m<=8) curSeason=seasons[1];
  else if(m===9) curSeason=seasons[2];
  else if(m>=10&&m<=11) curSeason=seasons[3];
  else curSeason=seasons[4];

  const seasonText = `지금은 <strong style="color:var(--bc-accent)">${curSeason.name}</strong>입니다.<br>
    ${bcData.ohaeng} 체질과 ${curSeason.ohaeng}의 조합에서 주의할 점:<br>
    <span class="id-accent">${curSeason.desc}</span>`;
  const el = document.getElementById('ch7CurrentSeasonText');
  if(el) el.innerHTML = seasonText;

  // 마인드셋 카드
  const mindsets = [
    {icon:'🔄', title:'완벽하지 않아도 됩니다', desc:'오늘 실수했다면 내일 다시 시작하면 됩니다. 균형으로 돌아오는 것이 오행의 본질입니다.'},
    {icon:'⏰', title:'빠른 결과보다 지속성을', desc:'12주 안에 모든 것을 바꾸려 하지 마세요. 한 가지 습관을 완전히 자동화하는 것이 우선입니다.'},
    {icon:'🎯', title:'체중이 아닌 에너지를 측정하세요', desc:'체중계보다 에너지 레벨, 수면 질, 소화 상태를 먼저 확인하세요. 이것들이 먼저 바뀝니다.'}
  ];
  safeHtml('ch7MindsetCards', mindsets.map(m=>`
    <div class="rx-card">
      <div class="rx-icon">${m.icon}</div>
      <div class="rx-body">
        <div class="rx-title">${m.title}</div>
        <div class="rx-desc">${m.desc}</div>
      </div>
    </div>`).join(''));
}

/* ─────────────────────────────────
   15. CH8 렌더링 (컨설턴트·체크인)
───────────────────────────────── */
function renderCh8(res, bc) {
  const bcData = BC_DB[bc] || BC_DB['BC-01'];
  const safeHtml = (id, v) => { const e = document.getElementById(id); if(e) e.innerHTML = v||''; };
  const safeSet = (id, v) => { const e = document.getElementById(id); if(e) e.textContent = v||''; };

  // 요약 그리드
  safeHtml('ch8SummaryGrid', `
    <div class="mini-card"><div class="mc-icon">🎯</div><div class="mc-val">${bc}</div><div class="mc-label">바디코드</div></div>
    <div class="mini-card"><div class="mc-icon">🌿</div><div class="mc-val">${bcData.ohaeng.split(' ')[0]||'토'}</div><div class="mc-label">오행 기질</div></div>
    <div class="mini-card"><div class="mc-icon">⚡</div><div class="mc-val">${(bcData.topAxes||['A1'])[0]}</div><div class="mc-label">최우선 축</div></div>
    <div class="mini-card"><div class="mc-icon">📅</div><div class="mc-val">12주</div><div class="mc-label">변화 기간</div></div>
  `);

  // 컨설턴트 노트
  safeHtml('ch8ConsultantNote', bcData.consultantNote || '맞춤 처방이 준비되었습니다. 컨설턴트와 함께 첫 번째 주를 시작하세요.');

  const params = new URLSearchParams(window.location.search);
  const consultantCode = params.get('ref') || '';
  safeSet('ch8ConsultantName', consultantCode ? `담당 컨설턴트 (${consultantCode})` : 'SlimMind 컨설턴트');

  // 선언문
  safeSet('ch8DeclBcCode', bc);
  safeSet('ch8DeclName', bcData.name || '');
}

function doFirstCheckin() {
  const btn = document.getElementById('ch8CheckinBtn');
  const done = document.getElementById('ch8CheckinDone');
  if (btn) btn.style.display = 'none';
  if (done) done.style.display = 'block';

  const params = new URLSearchParams(window.location.search);
  fetch('/api/checkin', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({
      result_id: params.get('id') || params.get('result_id') || 'first',
      consultant_code: params.get('ref') || '',
      bc_code: window._bcCode || '',
      week_range: 'WEEK 0',
      axis_name: '진단완료'
    })
  }).catch(() => {});
}

/* ─────────────────────────────────
   16. 메인 init
───────────────────────────────── */
async function init() {
  const params = new URLSearchParams(window.location.search);
  const resultId = params.get('id') || params.get('result_id') || '';

  // 결과 데이터 로드
  let res = {};
  if (resultId) {
    try {
      const resp = await fetch(`/api/result/${resultId}`);
      if (resp.ok) res = await resp.json();
    } catch(e) {
      console.warn('[init] API fetch failed, using URL params', e);
    }
  }

  // URL 파라미터 폴백
  if (!res.bc_code && params.get('bc')) res.bc_code = params.get('bc');
  if (!res.name && params.get('name')) res.name = decodeURIComponent(params.get('name'));
  if (!res.bmi && params.get('bmi')) res.bmi = params.get('bmi');
  if (!res.age && params.get('age')) res.age = params.get('age');

  const bc = res.bc_code || 'BC-01';
  window._bcCode = bc;
  window._resultData = res;

  // BC 테마 적용
  applyBcColorTheme(bc);

  // 각 챕터 렌더링
  renderCover(res, bc);
  renderCh1(res, bc);
  // CH2는 정적 HTML (BC별 내용은 JS로 동적 교체 불필요)
  renderCh3(bc);
  renderCh4(bc);
  renderWeeklyClickTree(res, bc);
  renderCh6(bc);
  renderCh7(bc);
  renderCh8(res, bc);

  // 로딩 해제, 첫 챕터 표시
  const loading = document.getElementById('loadingState');
  const wrap = document.getElementById('a4Wrap');
  if (loading) loading.style.display = 'none';
  if (wrap) wrap.style.display = 'block';

  gotoChapter(0);
}

// 페이지 로드 시 실행
window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
