  'E-06': { // 불안·감정 섭식형
    'BC-01':{headline:'불안이 혈당을 흔들고 있었습니다',body:'불안 → 코르티솔 → 혈당 불안정 → 당 갈망의 연결.',insight:'불안 감소가 혈당 안정의 절반입니다.',action:'마그네슘 300mg이 불안과 혈당을 동시에 안정시킵니다.'},
    'BC-02':{headline:'걱정이 간을 혹사시키고 있었습니다',body:'만성 불안은 간의 산화 스트레스를 높입니다.',insight:'마음의 해독과 간의 해독은 같은 방향입니다.',action:'명상+밀크시슬의 조합이 간과 마음을 동시에 보호합니다.'},
    'BC-03':{headline:'불안이 몸을 붓게 만들고 있었습니다',body:'교감신경 과활성화는 항이뇨 호르몬(ADH)을 올려 수분을 보유합니다.',insight:'불안이 해소되면 부종도 함께 해소됩니다.',action:'호흡 명상이 ADH를 낮추고 부종을 줄입니다.'},
    'BC-04':{headline:'불안이 코르티솔 폭주를 만들고 있었습니다',body:'불안장애와 HPA 축 과활성화는 악순환 구조입니다.',insight:'이것은 의지력 문제가 아닌 신경계 조절 문제입니다.',action:'L-테아닌+마그네슘+규칙적 수면이 HPA 축을 안정시킵니다.'},
    'BC-05':{headline:'불안이 갑상선을 억제하고 있었습니다',body:'만성 불안은 T3 전환을 방해하는 역T3를 만들어냅니다.',insight:'갑상선 수치가 정상이어도 불안이 있으면 기능이 저하됩니다.',action:'아슈와간다가 불안과 갑상선을 동시에 지원합니다.'},
    'BC-06':{headline:'불안이 장-뇌 축을 통해 장을 망가뜨렸습니다',body:'미주신경이 불안 신호를 장으로 전달해 장내 생태계가 무너집니다.',insight:'장이 불편할수록 불안이 심해지는 악순환입니다.',action:'프로바이오틱스가 세로토닌 90%가 만들어지는 장을 회복시킵니다.'},
    'BC-07':{headline:'불안이 심장을 지속적으로 긴장시켰습니다',body:'불안은 심박수와 혈압을 만성적으로 높입니다.',insight:'심혈관형에게 불안은 구조적 위험입니다.',action:'심호흡+마그네슘이 심장을 진정시킵니다.'},
    'BC-08':{headline:'불안이 호르몬 주기를 망가뜨리고 있었습니다',body:'만성 불안은 GnRH 박동 패턴을 교란해 성호르몬 균형을 무너뜨립니다.',insight:'생리 불규칙과 감정 기복의 깊은 원인입니다.',action:'L-테아닌+비텍스+규칙적 수면으로 주기를 안정시키세요.'},
