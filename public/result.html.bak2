/* ─────────────────────────────────
   3. 감정유형 분류 함수
───────────────────────────────── */
function classifyEmotionType(res) {
  const scores = res && res.scores ? res.scores : {};
  const s = (k) => Number(scores[k] || 0);
  if (s('stress') >= 4 && s('sleep') <= 2) return 'E-01';
  if (s('binge') >= 3 && s('guilt') >= 3) return 'E-02';
  if (s('tired') >= 4 && s('motivation') <= 2) return 'E-03';
  if (s('cravings') >= 4) return 'E-04';
  if (s('social') >= 3 && s('binge') >= 2) return 'E-05';
  if (s('anxiety') >= 4) return 'E-06';
  return 'E-07';
}

