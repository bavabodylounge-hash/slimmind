      <div id="ch8ConsultantNote" style="font-size:12.5px;color:#334155;line-height:1.9"></div>
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--bc-mid)">
        <div style="font-size:10px;color:#94A3B8;margin-bottom:4px">담당 컨설턴트</div>
        <div id="ch8ConsultantName" style="font-size:13px;font-weight:700;color:var(--bc-main)">SlimMind 컨설턴트</div>
      </div>
    </div>

    <div class="sec-divider"></div>

    <!-- 체크인 섹션 -->
    <div class="sec-title">첫 번째 체크인</div>
    <div style="background:#F8FAFC;border-radius:14px;padding:18px;margin:10px 0;border:1px solid #E2E8F0">
