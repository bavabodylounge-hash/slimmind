    ohaengDesc:'폐(肺)·대장 계열 — 산소·에너지 전환 효율이 낮습니다. 기초대사율이 낮고 같은 칼로리에도 체중이 잘 빠지지 않습니다.',
    scienceFact:'T3 수치가 10% 낮아질 때마다 기초대사율이 5~7% 감소합니다. 갑상선 기능 저하는 지방 산화와 체온 조절 모두를 저하시킵니다.',
    scienceCite:'— Mullur et al. (2014). Thyroid hormone regulation of metabolism. Physiol. Rev.',
    traits:['항상 추위를 많이 타고 손발이 차갑습니다','조금만 먹어도 체중이 늘어나는 경험을 합니다','무기력하고 두뇌 회전이 느려지는 느낌이 듭니다'],
    metaProfile:[{icon:'🔥',label:'기초대사율',val:'낮음'},{icon:'❄️',label:'냉증',val:'강함'},{icon:'⚡',label:'에너지 생성',val:'저하'},{icon:'🧠',label:'인지·집중',val:'저하 경향'}],
    topAxes:['A5 갑상선·대사','A10 미토콘드리아','A1 인슐린'],
    consultantNote:'BC-05는 갑상선 기능 확인이 최우선입니다. TSH·fT3·fT4 수치를 확인하고 셀레늄·아이오딘 영양 상태를 파악해 주세요.',
    diet:[{icon:'🥚',cat:'핵심',title:'셀레늄·아이오딘 식품 우선',desc:'달걀·해조류·브라질넛. 갑상선 호르몬 합성의 직접 원료입니다.'},{icon:'🚫',cat:'주의',title:'십자화과 생채소 과잉 주의',desc:'브로콜리·케일 생식은 갑상선 기능 저하형에게 역효과. 반드시 익혀서 섭취하세요.'},{icon:'🍗',cat:'보조',title:'고단백 소식 패턴',desc:'기초대사율 유지를 위해 단백질이 우선입니다. 체중 1kg당 1.6g 목표.'}],
    exercise:[{icon:'🏋️',cat:'1순위',title:'근력 운동 주 4회',desc:'근육량 증가가 기초대사율을 직접 높입니다. 갑상선 저하형에게는 유산소보다 근력이 먼저입니다.'},{icon:'🔥',cat:'2순위',title:'HIIT(고강도인터벌) 주 2회',desc:'미토콘드리아 생합성을 촉진하여 세포 수준의 대사율을 높입니다.'}],
    suppl:[{icon:'🌿',cat:'1순위',title:'셀레늄 200mcg',desc:'T4→T3 전환 효소(디요오디나아제)의 필수 보조인자.'},{icon:'💊',cat:'2순위',title:'아이오딘 150mcg',desc:'갑상선 호르몬 합성 원료. 음식으로 충분하지 않을 경우 보충합니다.'},{icon:'🍄',cat:'3순위',title:'코엔자임Q10 100mg',desc:'미토콘드리아 에너지 생산 지원. 갑상선 저하로 저하된 세포 에너지를 보충합니다.'}]
  },
  'BC-06': {
    name:'장내미생물 불균형형',
    short:'장내 생태계',
    ohaeng:'土 토(土)',
    ohaengDesc:'비(脾)·위(胃)·대장 계열 — 소화·흡수·발효 과정이 핵심입니다. 장내 생태계가 무너지면 염증, 기분, 면역, 체중 모두가 영향받습니다.',
    scienceFact:'장내미생물 구성은 체중 조절 호르몬(GLP-1, PYY, 그렐린)을 직접 조절합니다. 비만인의 장내미생물 이식만으로 마른 쥐에서 비만이 유도됩니다.',
    scienceCite:'— Turnbaugh et al. (2006). An obesity-associated gut microbiome. Nature.',
    traits:['복부 팽만감이 잦고 방귀가 많습니다','기분이 불안정하고 장·뇌 연결이 느껴집니다','항생제 복용 후 체중이 급격히 늘었던 경험이 있습니다'],
    metaProfile:[{icon:'🦠',label:'마이크로바이옴 다양성',val:'낮음'},{icon:'🔥',label:'장내 염증',val:'높음'},{icon:'💩',label:'변비/설사 패턴',val:'있음'},{icon:'😤',label:'腸腦 연결',val:'불안정'}],
    topAxes:['A2 장내미생물','A3 염증','A6 면역'],
    consultantNote:'BC-06은 장 환경 개선이 모든 것의 기반입니다. 발효식품 도입과 식이섬유 증가를 동시에 진행하되, 처음에는 소량부터 시작해 적응하도록 안내해 주세요.',
    diet:[{icon:'🥛',cat:'핵심',title:'발효식품 매일 1회',desc:'김치·된장·요거트·케피어. 유익균 공급과 장 pH 조절.'},{icon:'🌾',cat:'핵심2',title:'식이섬유 30g 이상',desc:'프리바이오틱스 역할. 양파·마늘·귀리·콩류가 효과적입니다.'},{icon:'🚫',cat:'회피',title:'설탕·인공감미료 차단',desc:'Dysbiosis를 악화시키는 가장 강력한 요소입니다.'}],
    exercise:[{icon:'🚶',cat:'1순위',title:'규칙적 걷기 주 5회',desc:'장 연동운동을 직접 자극합니다. 식후 15분 걷기가 특히 효과적입니다.'},{icon:'🧘',cat:'2순위',title:'복식호흡·명상',desc:'미주신경 활성화 → 장 기능 개선. 하루 10분 복식호흡.'}],
    suppl:[{icon:'🦠',cat:'1순위',title:'프로바이오틱스 (다균주 50B CFU)',desc:'Lactobacillus + Bifidobacterium 복합. 냉장 보관 제품으로 선택하세요.'},{icon:'🌿',cat:'2순위',title:'L-글루타민 5g',desc:'장 점막 세포의 주요 연료. 장벽 완결성을 회복합니다.'},{icon:'🍵',cat:'3순위',title:'아연 15mg',desc:'장 점막 타이트정션 유지. 장 투과성(Leaky Gut) 개선.'}]
  },
  'BC-07': {
    name:'혈액순환·심혈관형',
    short:'순환·심혈관',
    ohaeng:'火 화(火)',
    ohaengDesc:'심(心)·혈맥 계열 — 심장 펌프력과 혈관 탄성이 핵심입니다. 순환이 저하되면 말초 산소 공급이 줄고 운동 능력과 지방 연소가 동시에 떨어집니다.',
    scienceFact:'심혈관 기능과 지방 대사는 불가분입니다. 최대산소섭취량(VO2max)이 10% 높을수록 복부지방 축적 위험이 22% 낮습니다.',
    scienceCite:'— Kodama et al. (2009). Cardiorespiratory fitness as a quantitative predictor. JAMA.',
    traits:['계단을 오르면 심장이 빨리 뛰고 숨이 차빠릅니다','얼굴이 빨개지거나 두근거림이 자주 있습니다','운동 후 회복이 느리고 다음날 피로가 남습니다'],
    metaProfile:[{icon:'❤️',label:'심폐 기능',val:'개선 필요'},{icon:'🩸',label:'혈압 경향',val:'높은 편'},{icon:'🔥',label:'산소 활용 능력',val:'낮음'},{icon:'💪',label:'운동 회복력',val:'느림'}],
    topAxes:['A7 심혈관·순환','A3 염증','A10 미토콘드리아'],
    consultantNote:'BC-07은 심폐 기능 기반부터 만들어야 합니다. 너무 강도 높은 운동은 오히려 역효과입니다. 중강도 유산소부터 8주간 기반을 다지는 것을 추천합니다.',
    diet:[{icon:'🫐',cat:'핵심',title:'항산화 플라보노이드 식품',desc:'베리류·다크초콜릿·적포도주(소량). 혈관 내피 기능을 보호합니다.'},{icon:'🐟',cat:'핵심2',title:'오메가-3 지방산 식품',desc:'연어·고등어·참치. 중성지방 감소와 혈관 탄성 개선.'},{icon:'🚫',cat:'회피',title:'트랜스지방·포화지방 과잉 차단',desc:'혈관벽 염증의 직접 원인입니다.'}],
    exercise:[{icon:'🚴',cat:'1순위',title:'중강도 유산소 주 5회',desc:'심박수 60~70% 강도 30~45분. VO2max를 점진적으로 올리는 가장 안전한 방법입니다.'},{icon:'🏋️',cat:'2순위',title:'근력 운동 주 2회',desc:'혈압 조절과 심장 부하 감소. 고혈압이 있다면 등척성 운동을 우선 피하세요.'}],
    suppl:[{icon:'❤️',cat:'1순위',title:'코엔자임Q10 200mg',desc:'심근 세포 에너지 생산. 스타틴 복용자에게 특히 중요합니다.'},{icon:'🌿',cat:'2순위',title:'오메가-3 3g',desc:'중성지방 감소 효과. EPA 비율이 높은 제품이 심혈관에 특히 유효합니다.'},{icon:'🍇',cat:'3순위',title:'레스베라트롤 200mg',desc:'혈관 내피 NO 생성 촉진. 혈관 탄성과 혈압 개선.'}]
  },
  'BC-08': {
    name:'호르몬 불균형형',
    short:'호르몬 균형',
    ohaeng:'水 수(水)',
    ohaengDesc:'신(腎)·부신 계열 — 성호르몬·부신 축이 핵심입니다. 에스트로겐 우세, 테스토스테론 저하, 부신 피로 등이 복합적으로 체중을 조절합니다.',
    scienceFact:'에스트로겐-프로게스테론 불균형은 지방 분포 패턴을 직접 결정합니다. 에스트로겐 우세 상태에서는 허벅지·엉덩이·복부에 지방이 선택적으로 축적됩니다.',
    scienceCite:'— Lizcano & Guzmán (2014). Estrogen Deficiency and the Origin of Obesity. ISRN Obesity.',
    traits:['생리 전후로 체중이 2~3kg 이상 변동합니다','감정 기복이 심하고 단 것이 특히 당깁니다','중년 이후 체형이 급격히 바뀌었습니다'],
    metaProfile:[{icon:'⚖️',label:'호르몬 균형',val:'불균형'},{icon:'🌙',label:'생리 주기',val:'불규칙'},{icon:'💊',label:'부신 기능',val:'피로'},{icon:'🔥',label:'지방 분포',val:'여성형/복합'}],
    topAxes:['A8 성호르몬','A4 부신·코르티솔','A9 신경호르몬'],
    consultantNote:'BC-08은 호르몬 주기를 이해하는 것이 먼저입니다. 생리 주기에 맞춰 운동 강도와 식단을 조정하는 "사이클 싱킹" 접근이 가장 효과적입니다.',
    diet:[{icon:'🥦',cat:'핵심',title:'DIM 함유 십자화과 채소',desc:'브로콜리·케일. DIM이 에스트로겐 대사를 건강한 방향으로 유도합니다.'},{icon:'🌱',cat:'핵심2',title:'식물성 리그난·이소플라본',desc:'아마씨·콩류·석류. 에스트로겐 수용체 조절.'},{icon:'🚫',cat:'회피',title:'제노에스트로겐 노출 최소화',desc:'플라스틱 용기·향수·농약 잔류물. 환경 호르몬은 에스트로겐 과잉을 악화합니다.'}],
    exercise:[{icon:'🧘',cat:'1순위',title:'사이클 싱킹 운동',desc:'생리 전반기: 유산소·HIIT. 생리 후반기: 스트레칭·요가. 호르몬 리듬에 맞춘 운동이 효과 2배입니다.'},{icon:'🏋️',cat:'2순위',title:'근력 운동 주 2~3회',desc:'테스토스테론 지원. 특히 하체 근력이 성호르몬 균형에 기여합니다.'}],
    suppl:[{icon:'🌿',cat:'1순위',title:'DIM 200mg',desc:'에스트로겐 대사 조절의 황금 표준.'},{icon:'💊',cat:'2순위',title:'마그네슘 400mg',desc:'PMS 증상과 코르티솔 수치를 동시에 낮춥니다.'},{icon:'🍃',cat:'3순위',title:'비텍스(체이스트베리) 400mg',desc:'황체 기능 지원. 생리 전 증후군 완화에 임상적으로 검증된 허브입니다.'}]
  },
  'BC-09': {
    name:'면역·염증 과민형',
    short:'면역·염증',
    ohaeng:'金 금(金)',
    ohaengDesc:'폐(肺)·피부·면역 계열 — 알레르기, 자가면역, 만성 염증이 체중 조절을 방해합니다. 염증은 지방세포를 키우고, 지방세포는 다시 염증을 키웁니다.',
    scienceFact:'만성 저등급 염증(Low-grade chronic inflammation)은 렙틴 저항성을 유발합니다. 뇌가 포만 신호를 읽지 못하면 과식이 멈추지 않습니다.',
    scienceCite:'— Hotamisligil GS (2006). Inflammation and metabolic disorders. Nature.',
    traits:['알레르기·아토피·비염이 있거나 있었습니다','특정 음식을 먹으면 컨디션이 급격히 나빠집니다','체중과 무관하게 몸이 무겁고 염증 반응이 잦습니다'],
    metaProfile:[{icon:'🔥',label:'전신 염증 수준',val:'높음'},{icon:'🛡️',label:'면역 과민성',val:'있음'},{icon:'🍎',label:'음식 민감도',val:'복수'},{icon:'🌿',label:'항산화 상태',val:'부족'}],
    topAxes:['A3 염증·항산화','A6 면역','A2 장내미생물'],
    consultantNote:'BC-09는 항염 식단이 모든 처방의 기반입니다. 음식 일기를 통해 개인별 트리거 식품을 찾는 것이 첫 번째 과제입니다.',
    diet:[{icon:'🫐',cat:'핵심',title:'항염 식품 우선 식단',desc:'베리류·강황·생강·오메가-3 지방산. 매 식사에 항염 성분이 포함되도록 설계합니다.'},{icon:'🚫',cat:'회피',title:'6대 알레르기 식품 순차 제거',desc:'밀·유제품·계란·견과·콩·옥수수. 4주 제거 후 순차 도입으로 개인 트리거를 찾습니다.'},{icon:'🌿',cat:'보조',title:'강황·생강 매일 섭취',desc:'쿠르쿠민·진저롤의 NF-κB 억제 효과. 조리에 활용하거나 차로 섭취하세요.'}],
    exercise:[{icon:'🧘',cat:'1순위',title:'저강도 요가·스트레칭',desc:'고강도 운동은 초기에 염증을 악화시킵니다. 항염 상태가 자리잡은 후 강도를 올리세요.'},{icon:'🚶',cat:'2순위',title:'자연 속 걷기',desc:'피톤치드는 NK세포 활성을 높이고 염증 마커를 낮춥니다. 주 2회 숲 걷기를 추천합니다.'}],
    suppl:[{icon:'🌿',cat:'1순위',title:'쿠르쿠민(피페린 복합) 500mg',desc:'BCM-95 또는 피페린 복합으로 흡수율을 높인 제품. NF-κB 억제.'},{icon:'🐟',cat:'2순위',title:'오메가-3 3g (EPA 우선)',desc:'염증성 에이코사노이드 생성을 직접 억제합니다.'},{icon:'🍄',cat:'3순위',title:'비타민D3 5,000IU',desc:'면역 조절 마스터 호르몬. 대부분의 면역 과민형에서 결핍이 확인됩니다.'}]
  },
  'BC-10': {
    name:'복합 대사 증후군형',
    short:'복합 대사',
    ohaeng:'土木水 복합',
    ohaengDesc:'복수 오행 복합 — 여러 계통이 동시에 불균형 상태입니다. 한 가지 접근보다 우선순위를 정해 순차적으로 개입하는 것이 핵심입니다.',
    scienceFact:'대사증후군은 복부비만·고혈압·고혈당·이상지질혈증이 복합된 상태입니다. 이 중 하나만 개선해도 나머지가 연쇄적으로 개선되는 도미노 효과가 나타납니다.',
    scienceCite:'— Eckel et al. (2005). The metabolic syndrome. Lancet.',
