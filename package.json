{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node_modules/.bin/jest --config jest.config.cjs --passWithNoTests",
    "test:unit": "node_modules/.bin/jest --config jest.config.cjs",
    "dev": "vite",
    "build": "vite build && node scripts/patch-routes.cjs",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "start": "pm2 start ecosystem.config.cjs",
    "start:watch": "pm2 start ecosystem.config.cjs --only watch-build",
    "stop:watch": "pm2 stop watch-build",
    "rebuild": "npm run build && pm2 restart slimmind",
    "logs:watch": "pm2 logs watch-build --nostream --lines 30",
    "lint:hardcode": "node tests/hardcoding-linter.cjs"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "playwright": "^1.62.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
